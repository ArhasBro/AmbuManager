{
  "name": "VehicleCheck",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "vehicle_type": {
      "type": "string"
    },
    "immatriculation": {
      "type": "string"
    },
    "depot_id": {
      "type": "string"
    },
    "depot_name": {
      "type": "string"
    },
    "check_date": {
      "type": "string",
      "format": "date"
    },
    "checker_1": {
      "type": "string"
    },
    "checker_2": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "Conforme",
        "Non conforme",
        "Sous r\u00e9serve",
        "\u00c0 v\u00e9rifier"
      ],
      "default": "\u00c0 v\u00e9rifier"
    },
    "anomaly_linked": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "vehicle_id",
    "check_date"
  ]
}