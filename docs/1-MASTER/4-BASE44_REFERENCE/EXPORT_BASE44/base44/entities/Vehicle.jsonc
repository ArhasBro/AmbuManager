{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom / mod\u00e8le du v\u00e9hicule"
    },
    "immatriculation": {
      "type": "string",
      "description": "Immatriculation"
    },
    "type": {
      "type": "string",
      "enum": [
        "AMBULANCE",
        "VSL",
        "TAXI",
        "TPMR"
      ],
      "default": "AMBULANCE"
    },
    "admin_status": {
      "type": "string",
      "enum": [
        "Actif",
        "Inactif"
      ],
      "default": "Actif",
      "description": "Statut administratif"
    },
    "availability": {
      "type": "string",
      "enum": [
        "Disponible",
        "Indisponible"
      ],
      "default": "Disponible",
      "description": "Disponibilit\u00e9 op\u00e9rationnelle"
    },
    "availability_reason": {
      "type": "string",
      "description": "Motif obligatoire lors d'un passage en Indisponible"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Archivage (jamais de suppression physique)"
    },
    "depot_id": {
      "type": "string"
    },
    "depot_name": {
      "type": "string"
    },
    "seats": {
      "type": "number"
    },
    "mileage": {
      "type": "number"
    },
    "insurance_expires_at": {
      "type": "string",
      "format": "date"
    },
    "technical_inspection_expires_at": {
      "type": "string",
      "format": "date"
    },
    "sanitary_approval_expires_at": {
      "type": "string",
      "format": "date"
    },
    "registration_document_present": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "immatriculation",
    "type"
  ]
}