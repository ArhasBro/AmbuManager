+
+function readOptionalEnv(envName: string): string | null {
+  const value = process.env[envName];
+  if (typeof value !== "string") return null;
+
+  const trimmed = value.trim();
+  return trimmed.length > 0 ? trimmed : null;
+}
+
+function readSupportSeedIdentity(): SupportSeedIdentity | null {
+  const name = readOptionalEnv("SEED_SUPPORT_NAME");
+  const email = readOptionalEnv("SEED_SUPPORT_EMAIL");
+  const password = readOptionalEnv("SEED_SUPPORT_PASSWORD");
+
+  const providedCount = [name, email, password].filter((value): value is string => value !== null).length;
+
+  if (providedCount === 0) return null;
+
+  if (name === null || email === null || password === null) {
+    throw new Error(
+      "Incomplete support seed configuration. Define SEED_SUPPORT_NAME, SEED_SUPPORT_EMAIL and SEED_SUPPORT_PASSWORD together."
+    );
+  }
+
+  return {
+    name,
+    email: email.toLowerCase(),
+    password,
+  };
+}
+
+function isMissingPlatformRoleColumnError(error: unknown): boolean {
+  if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === "P2022") {
+    const column = typeof error.meta?.column === "string" ? error.meta.column : "";
+    if (column.includes("platformRole")) return true;
+  }
+
+  if (!(error instanceof Error)) return false;
+
+  const message = error.message.toLowerCase();
+  return message.includes("platformrole") && (
+    message.includes("does not exist") ||
+    message.includes("column") ||
+    message.includes("p2022")
+  );
+}
