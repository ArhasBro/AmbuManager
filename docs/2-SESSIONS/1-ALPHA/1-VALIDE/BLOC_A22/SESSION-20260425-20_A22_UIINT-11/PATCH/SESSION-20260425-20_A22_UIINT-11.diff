+
+.onboarding-row-list {
+  display: grid;
+  gap: 8px;
+}
+
+.onboarding-row-card {
+  display: grid;
+  gap: 8px;
+  border: 1px solid var(--ui-border);
+  border-radius: 10px;
+  padding: 10px;
+}
+
+.onboarding-row-grid {
+  display: grid;
+  gap: 6px;
+}
+
+.onboarding-row-grid__item {
+  display: grid;
+  grid-template-columns: 180px minmax(0, 1fr);
