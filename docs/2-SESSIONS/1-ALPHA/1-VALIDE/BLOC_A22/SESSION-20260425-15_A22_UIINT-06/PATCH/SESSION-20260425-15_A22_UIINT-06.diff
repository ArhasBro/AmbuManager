+}
+
+.planning-legacy {
+  background: var(--ui-surface);
+  box-shadow: var(--ui-shadow);
+}
+
+.planning-legacy__head {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+
+.planning-legacy__actions {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.planning-legacy__toolbar {
+  display: flex;
+  gap: 8px;
+  align-items: center;
+  flex-wrap: wrap;
+}
+
+.planning-legacy__week-grid {
+  display: grid;
+  gap: 10px;
+  grid-template-columns: repeat(7, minmax(160px, 1fr));
+}
+
+.planning-legacy__day-card {
+  background: var(--ui-surface);
+}
+
+.planning-manual {
+  background: linear-gradient(180deg, rgba(29, 78, 216, 0.05) 0%, var(--ui-surface) 220px);
+}
+
+.planning-manual__header {
+  display: grid;
+  gap: 6px;
+}
+
+.planning-manual__title {
+  margin: 0;
+  font-size: 22px;
+  font-weight: 800;
+  color: #1e3a8a;
+}
+
+.planning-manual__description {
+  margin: 0;
+  color: var(--ui-text-muted);
+}
+
+.planning-manual__badges {
+  display: inline-flex;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+
+.planning-manual__toolbar {
+  border: 1px solid var(--ui-border);
+  border-radius: 12px;
+  background: var(--ui-surface-soft);
+  padding: 12px;
+}
+
+.planning-manual__toolbar-actions {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+
+.planning-manual__editor {
+  border: 1px solid var(--ui-border);
+  border-radius: 12px;
+  background: var(--ui-surface);
+  box-shadow: var(--ui-shadow);
+}
+
+.planning-manual__editor-title {
+  font-weight: 800;
+  color: #1e3a8a;
+}
+
+.planning-manual__editor-actions {
+  display: inline-flex;
+}
+
+.planning-manual__feedback {
+  border-radius: 10px;
+  padding: 10px 12px;
+  border: 1px solid transparent;
+}
+
+.planning-manual__feedback--success {
+  border-color: var(--ui-success-border);
+  background: var(--ui-success-bg);
+  color: var(--ui-success-text);
+}
+
+.planning-manual__loading {
+  border: 1px dashed var(--ui-border-strong);
+  border-radius: 12px;
+  padding: 12px;
+  color: var(--ui-text-muted);
+  background: var(--ui-surface-soft);
+}
+
+.planning-manual__month-grid {
+  display: grid;
+  gap: 8px;
+  grid-template-columns: repeat(7, minmax(120px, 1fr));
+}
+
+.planning-manual__day-card {
+  background: var(--ui-surface);
+  transition: border-color 0.15s ease, box-shadow 0.15s ease;
+}
+
+.planning-manual__day-card:hover {
+  border-color: var(--ui-border-strong);
+  box-shadow: var(--ui-shadow);
+}
+
+.planning-manual__day-card.is-muted {
+  opacity: 0.62;
+}
+
+.planning-manual__day-title {
+  color: #1e3a8a;
+}
+
+.planning-manual__day-empty {
+  color: var(--ui-text-muted);
+}
+
+.planning-manual__day-item {
+  border-left-width: 6px;
+  border-left-style: solid;
+}
+
+.planning-manual__day-item-template {
+  color: var(--ui-text);
+}
+
+.planning-manual__day-item-user,
+.planning-manual__day-more {
+  color: var(--ui-text-muted);
+}
+
+.planning-manual-shift {
+  background: var(--ui-surface);
+  box-shadow: var(--ui-shadow);
+}
+
+.planning-manual-shift__edit {
+  background: var(--ui-surface-soft);
+}
+
+.planning-manual-shift__history-title {
+  color: #1e3a8a;
+}
+
 @media (max-width: 1140px) {
