+function readOptionalTrimmedEnv(envName: string): string | null {
+  const value = process.env[envName];
+  if (typeof value !== "string") return null;
+
+  const trimmed = value.trim();
+  return trimmed.length > 0 ? trimmed : null;
+}
+
+type SupportSeedIdentity = {
+  name: string;
+  email: string;
+  password: string;
+};
+
+function readSupportSeedIdentity(): SupportSeedIdentity | null {
+  const name = readOptionalTrimmedEnv("SEED_SUPPORT_NAME");
+  const email = readOptionalTrimmedEnv("SEED_SUPPORT_EMAIL");
+  const password = readOptionalTrimmedEnv("SEED_SUPPORT_PASSWORD");
+
+  if (name === null && email === null && password === null) {
+    return null;
+  }
+
+  if (name === null || email === null || password === null) {
+    throw new Error(
+      "Partial support seed configuration. Define SEED_SUPPORT_NAME, SEED_SUPPORT_EMAIL and SEED_SUPPORT_PASSWORD together."
+    );
+  }
+
+  return {
+    name,
+    email: email.toLowerCase(),
+    password,
+  };
+}
+
+function isMissingPlatformRoleColumnError(error: unknown): boolean {
+  const message = error instanceof Error ? error.message : String(error);
+  return message.includes("platformRole") && message.includes("does not exist in the current database");
+}
