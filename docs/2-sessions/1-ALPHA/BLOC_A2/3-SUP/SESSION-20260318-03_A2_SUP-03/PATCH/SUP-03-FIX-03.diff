+type SupportSeedIdentity = {
+  name: string;
+  email: string;
+  password: string;
+};
+
+function readOptionalSeedValue(envName: string): string | null {
+  const value = process.env[envName];
+  if (typeof value !== "string") return null;
+
+  const trimmed = value.trim();
+  return trimmed.length > 0 ? trimmed : null;
+}
+
+function readSupportSeedIdentity(): SupportSeedIdentity | null {
+  const nameValue = readOptionalSeedValue("SEED_SUPPORT_NAME");
+  const emailValue = readOptionalSeedValue("SEED_SUPPORT_EMAIL");
+  const passwordValue = readOptionalSeedValue("SEED_SUPPORT_PASSWORD");
+
+  const providedValues = [nameValue, emailValue, passwordValue].filter((value): value is string => value !== null).length;
+
+  if (providedValues === 0) return null;
+
+  if (providedValues !== 3 || nameValue === null || emailValue === null || passwordValue === null) {
+    throw new Error(
+      "Incomplete support seed configuration. Define SEED_SUPPORT_NAME, SEED_SUPPORT_EMAIL and SEED_SUPPORT_PASSWORD together."
+    );
+  }
+
+  return {
+    name: nameValue,
+    email: emailValue.toLowerCase(),
+    password: passwordValue,
+  };
+}
+
+function getErrorMessage(error: unknown): string {
+  if (error instanceof Error) return error.message;
+  return String(error);
+}
+
+function isMissingPlatformRoleColumnError(error: unknown): boolean {
+  const message = getErrorMessage(error).toLowerCase();
+
+  return (
+    message.includes("platformrole") &&
+    message.includes("column") &&
+    (message.includes("does not exist") || message.includes("unknown column") || message.includes("missing"))
+  );
+}
