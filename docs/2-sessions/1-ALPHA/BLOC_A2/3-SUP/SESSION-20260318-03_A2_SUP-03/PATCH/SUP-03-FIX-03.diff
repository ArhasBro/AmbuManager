+async function upsertSupportUser(identity: SupportSeedIdentity) {
+  const hashedPassword = await bcrypt.hash(identity.password, 10);
+
+  try {
+    const user = await prisma.user.upsert({
+      where: { email: identity.email },
+      update: {
+        name: identity.name,
+        password: hashedPassword,
+        platformRole: PlatformRole.SUPPORT,
+        role: null,
+        companyId: null,
+        depotId: null,
+      },
+      create: {
+        email: identity.email,
+        password: hashedPassword,
+        name: identity.name,
+        platformRole: PlatformRole.SUPPORT,
+        role: null,
+        companyId: null,
+        depotId: null,
+      },
+    });
+
+    await prisma.userPermission.deleteMany({
+      where: { userId: user.id },
+    });
+
+    console.log("✅ Support user upserted:", user.email, user.id);
+    return user;
+  } catch (error) {
+    if (isMissingPlatformRoleColumnError(error)) {
+      console.warn(
+        "⚠️  Compte support non seedé : colonne User.platformRole absente de la base courante. Aligner la base avec les migrations SUP-02 avant d'activer le seed support."
+      );
+      return null;
+    }
+
+    throw error;
+  }
+}
