+import { createUserBodySchema } from "@/lib/validators/user";
+import bcrypt from "bcrypt";
 import { z } from "zod";

 const USER_ROLES = ["ADMIN", "GERANT", "BUREAU", "ADE", "AA", "TAXI", "REGULATEUR"] as const;
+
+const userSelect = {
