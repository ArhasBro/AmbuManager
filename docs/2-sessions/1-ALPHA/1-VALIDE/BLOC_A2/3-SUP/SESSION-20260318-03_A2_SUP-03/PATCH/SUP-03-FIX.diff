+type SupportSeedIdentity = {
+  name: string;
+  email: string;
+  password: string;
+};
+
+function readOptionalSeedValue(envName: string): string | null {
+  const value = process.env[envName];
+  if (typeof value !== "string") return null;
+
+  const trimmedValue = value.trim();
+  return trimmedValue.length > 0 ? trimmedValue : null;
+}
+
+function readSupportSeedIdentity(): SupportSeedIdentity | null {
+  const name = readOptionalSeedValue("SEED_SUPPORT_NAME");
+  const email = readOptionalSeedValue("SEED_SUPPORT_EMAIL");
+  const password = readOptionalSeedValue("SEED_SUPPORT_PASSWORD");
+
+  const providedCount = [name, email, password].filter((value) => value !== null).length;
+
+  if (providedCount === 0) return null;
+
+  if (providedCount !== 3 || name === null || email === null || password === null) {
+    throw new Error(
+      "Support seed configuration is partial. Define SEED_SUPPORT_NAME, SEED_SUPPORT_EMAIL and SEED_SUPPORT_PASSWORD together."
+    );
+  }
+
+  return {
+    name,
+    email: email.toLowerCase(),
+    password,
+  };
+}
+
+function isMissingSupportPlatformRoleColumn(error: unknown): boolean {
+  if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === "P2022") {
+    const column = typeof error.meta?.column === "string" ? error.meta.column : "";
+    if (column.includes("platformRole")) return true;
+  }
+
+  const message = error instanceof Error ? error.message : String(error);
+
+  return message.includes("platformRole") && (message.includes("does not exist") || message.includes("Unknown column"));
 }
 
